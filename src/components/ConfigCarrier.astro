---

import { normalizeLocale } from "@i18n/translation";
import { siteConfig } from "../config";

const locale = normalizeLocale(Astro.props.locale);
---

<div id="config-carrier" data-hue={siteConfig.themeColor.hue} data-lightDarkMode={siteConfig.lightDarkMode.defaultMode} data-locale={locale}>
</div>
