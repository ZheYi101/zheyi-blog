---
import type { Locale } from "@/types/config";
import { friendLinks } from "@/constants/friends";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@layouts/MainGridLayout.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<MainGridLayout title={i18n(locale, I18nKey.friendLink)} description={i18n(locale, I18nKey.friendLink)} locale={locale}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-8 my-4">
                {friendLinks.map((item) => (
                    <div class="flex flex-nowrap items-stretch h-28 gap-4 rounded-[var(--radius-large)]">
                        <div class="w-28 h-28 flex-shrink-0 rounded-lg overflow-hidden bg-zinc-200 dark:bg-zinc-900">
                            <a aria-label="Go to His/Her Blog" href={item.url} target="_blank"
                            class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
                            max-w-[12rem] lg:max-w-none overflow-hidden rounded-xl active:scale-95">
                                <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
                                w-full h-full z-50 flex items-center justify-center">
                                    <Icon name="fa6-regular:address-card"
                                        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
                                    </Icon>
                                </div>
                                <ImageWrapper src={item.avatar || "/image/defaultAvatar.png"} alt="Avatar" class="mx-auto lg:w-full h-full lg:mt-0 "></ImageWrapper>
                            </a>
                        </div>
                        <div class="grow w-full">
                            <div class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 mb-1">{item.name}</div>
                            <div class="text-50 text-sm font-medium whitespace-pre-wrap">{item.description}</div>
                        </div>
                        <a href={item.url} target="_blank" rel="noopener noreferrer"class="flex btn-regular w-[3.25rem] rounded-lg bg-[var(--enter-btn-bg)] hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95">
                            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="transition text-[var(--primary)] text-4xl mx-auto iconify iconify--material-symbols" width="1em" height="1em" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M12.6 12L8.7 8.1q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.6 4.6q.15.15.213.325t.062.375t-.062.375t-.213.325l-4.6 4.6q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7z"></path>
                            </svg>
                        </a>
                    </div>
                ))}
            </div>
        </div>
    </div>
</MainGridLayout>