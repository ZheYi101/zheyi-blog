---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/types/config";
import { getCategoryKey, getPostSlug } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page, locale } = Astro.props as { page: { data: CollectionEntry<"posts">[] }; locale: Locale };

let delay = 0;
const interval = 50;
---
<div class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4 mb-4">
    {page.data.map((entry: CollectionEntry<"posts">) => (
        <PostCard
                entry={entry}
                title={entry.data.title}
                tags={entry.data.tags}
                categoryKey={getCategoryKey(entry)}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(getPostSlug(entry), locale)}
                image={entry.data.image}
                description={entry.data.description}
                draft={entry.data.draft}
                locale={locale}
                class:list="onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
        ></PostCard>
    ))}
</div>